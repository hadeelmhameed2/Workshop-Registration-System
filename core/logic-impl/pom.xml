<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- logic-impl: the implementation of WorkshopSystem -->
    <parent>
        <groupId>patmal.workshops.student.impl</groupId>
        <artifactId>core</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>logic-impl</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>patmal.workshops.student.impl</groupId>
            <artifactId>model-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>patmal.workshops</groupId>
            <artifactId>logic</artifactId>
        </dependency>
        <!--
            The API jars were installed without their own pom, so Maven does not know that
            logic uses model: model must be declared here explicitly.
        -->
        <dependency>
            <groupId>patmal.workshops</groupId>
            <artifactId>model</artifactId>
        </dependency>

        <!--
            Logging. The code is written against log4j-api only, so log4j-core (the
            implementation) is not needed to compile: it is a runtime dependency.
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- E-mail validation in createStudent / createInstructor -->
        <dependency>
            <groupId>commons-validator</groupId>
            <artifactId>commons-validator</artifactId>
        </dependency>

        <!-- The export...DataToJson methods -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- importStudentDataFromFile (bonus) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
        </dependency>
    </dependencies>
</project>
