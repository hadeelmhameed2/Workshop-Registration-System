<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        root: the aggregator of the whole build and the top parent of every module.
        The groupId and the version are declared only here; all modules inherit them.
    -->
    <groupId>patmal.workshops.student.impl</groupId>
    <artifactId>root</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Workshop Registration System</name>

    <modules>
        <module>core</module>
        <module>app</module>
    </modules>

    <properties>
        <!-- Build settings -->
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- API jars and tester (installed into the local repository, see README.md) -->
        <workshops.api.version>2.0</workshops.api.version>
        <workshop-tester.version>2.0</workshop-tester.version>

        <!-- Third-party libraries -->
        <log4j.version>2.26.1</log4j.version>
        <commons-validator.version>1.11.0</commons-validator.version>
        <jackson.version>2.22.4</jackson.version>
        <commons-csv.version>1.14.1</commons-csv.version>
        <!-- Transitive (from commons-csv), overridden: see dependencyManagement -->
        <commons-codec.version>1.23.0</commons-codec.version>

        <!-- Build plugins -->
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    </properties>

    <!--
        Versions only: nothing here is added to a module until the module lists the
        dependency itself, without a version.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- API jars -->
            <dependency>
                <groupId>patmal.workshops</groupId>
                <artifactId>model</artifactId>
                <version>${workshops.api.version}</version>
            </dependency>
            <dependency>
                <groupId>patmal.workshops</groupId>
                <artifactId>logic</artifactId>
                <version>${workshops.api.version}</version>
            </dependency>

            <!-- The tester is only used to check the build; it must never be packed into a jar -->
            <dependency>
                <groupId>patmal.workshops</groupId>
                <artifactId>workshop-tester</artifactId>
                <version>${workshop-tester.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Logging: the API is used by the code, the core is the implementation behind it -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.version}</version>
            </dependency>

            <!-- E-mail validation -->
            <dependency>
                <groupId>commons-validator</groupId>
                <artifactId>commons-validator</artifactId>
                <version>${commons-validator.version}</version>
            </dependency>

            <!-- JSON export -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- CSV import -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${commons-csv.version}</version>
            </dependency>
            <!--
                Not used directly: commons-csv brings commons-codec 1.19.0, which is affected by
                CVE-2026-119078 (versions 1.16.0 to 1.22.x, fixed in 1.23.0). Managing it here
                overrides the version of the transitive dependency in every module.
            -->
            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>${commons-codec.version}</version>
            </dependency>

            <!-- Our own modules -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>model-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>logic-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- Plugin versions, pinned once so that every module builds the same way -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
